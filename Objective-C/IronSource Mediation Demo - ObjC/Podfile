platform :ios, '12.0'

target 'IronSource Mediation Demo - ObjC' do
  # Comment the next line if you don't want to use dynamic frameworks
  use_frameworks!

  # Pods for IronSource Mediation Demo - ObjC
  # NOTE: ironSource-HyBid-Adapters 3.7.0.0 was built against IronSource SDK 7.x.
  # IronSource SDK 8.0 introduced the LevelPlay multiple ad unit architecture, which
  # requires adapters to register via the new ISAdapterRegistration protocol.
  # Because 3.7.0.0 does not implement that protocol, the IronSource SDK cannot find
  # or instantiate ISVerveAdapter at runtime, resulting in:
  #   "Error while getting classFromString: ISVerveAdapter"
  # A version of ironSource-HyBid-Adapters with IronSource SDK 8.0 support is needed to fix this.
  pod 'ironSource-HyBid-Adapters', '3.7.0.0'
  pod 'IronSourceSDK', '~> 8.0'
end
